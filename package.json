{
  "name": "parfumerie-backend",
  "version": "1.0.0",
  "description": "API REST – Sistema de Gestão de Perfumes",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed:run": "knex seed:run",
    "db:setup": "npm run migrate:latest && npm run seed:run",
    "db:init": "node scripts/init-db.js",
    "db:check": "node scripts/check-db.js",
    "deploy:migrations": "node deploy-migrations.js"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "knex": "^3.2.9",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "sqlite3": "^6.0.1"
  }
}
