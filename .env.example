# ===================================
# 🐘 PostgreSQL (Coolify)
# ===================================
# Configure com as credenciais do seu banco PostgreSQL no Coolify

DB_HOST=seu-postgres-host.coolify.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD="sua_senha_aqui"

# Ou use DATABASE_URL diretamente:
# DATABASE_URL=postgresql://postgres:senha@host:5432/postgres

# ===================================
# 🚀 Server
# ===================================
PORT=3001
NODE_ENV=development

# ─── Sincronizacao com a loja WooCommerce (portalupiparfum.com.br) ───────────
# Segredo compartilhado dos endpoints GET /api/public/catalog/stock e
# POST /api/public/catalog/validate-cart, chamados servidor-a-servidor pelo PHP
# da loja (header x-sync-secret).
#
# OPCIONAL: se esta variavel nao existir, o segredo e lido do parametro
# `catalog_sync_secret` (tela Sistema -> Parametros), que e o caminho usado
# hoje por nao exigir acesso ao painel do Coolify. Esta variavel, quando
# definida, tem PRECEDENCIA sobre o parametro.
#
# FALHA FECHADA: sem segredo em NENHUMA das duas fontes (ou com segredo em
# branco), os dois endpoints respondem 503 e a sincronizacao nao roda.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CATALOG_SYNC_SECRET=
