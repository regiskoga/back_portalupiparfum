# ===================================
# 🐘 PostgreSQL (Coolify)
# ===================================
# Configure com as credenciais do seu banco PostgreSQL no Coolify

DB_HOST=seu-postgres-host.coolify.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD="sua_senha_aqui"

# Ou use DATABASE_URL diretamente:
# DATABASE_URL=postgresql://postgres:senha@host:5432/postgres

# ===================================
# 🚀 Server
# ===================================
PORT=3001
NODE_ENV=development
